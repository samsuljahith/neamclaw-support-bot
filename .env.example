# ============================================================
# TechNova Support Bot — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# Bearer token for the HTTP API (change in production!)
NEAM_API_KEY=dev-key-change-me

# Anthropic API key for Claude Haiku (app/llm.py).
# Optional — if unset, the bot falls back to a rule-based responder
# (no LLM, covers only the most common support flows).
ANTHROPIC_API_KEY=sk-ant-...
